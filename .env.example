# Supabase（ダッシュボードの Project Settings → API Keys）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# サーバー専用の秘密鍵。ブラウザに出さないこと
SUPABASE_SECRET_KEY=

# 受付URL・QRコードのドメイン（未設定なら Vercel の本番URL）
APP_URL=http://localhost:3000

# メール（Resend）。未設定ならメールは送らずにログだけ出す
RESEND_API_KEY=
MAIL_FROM="SCRAMBLE SMILE 運営 <noreply@example.com>"
MAIL_REPLY_TO=

# ボット対策（Cloudflare Turnstile）。未設定なら検証しない
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 個人情報の自動削除（Vercel Cron）用の秘密の文字列
CRON_SECRET=

# 送信回数制限で使う IP のハッシュ用ソルト（任意の長い文字列）
IP_HASH_SALT=
