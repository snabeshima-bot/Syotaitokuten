# Supabase（ダッシュボードの Project Settings → API Keys）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 公開フォームの送信・修正で使うサーバーキー（長いランダムな文字列）。DB の app_private.server_keys に sha256 を入れておく
# ローカルは seed.sql で local-dev-server-key が入っている
APP_SERVER_KEY=local-dev-server-key
# Google ログインで候補に出すドメイン（スタッフにするドメインは DB の staff_email_domains）
STAFF_GOOGLE_DOMAIN=focpro.co.jp
# ローカルで npm run staff:create を使うときだけ（本番のアプリには不要）
SUPABASE_SECRET_KEY=

# 個人情報の暗号化鍵（それぞれ32バイトを base64 で）。作り方: openssl rand -base64 32
# 一度使い始めたら変えないこと（変えると保存済みのデータが読めなくなる）。パスワード管理ツールなどに控えておく
PII_ENCRYPTION_KEY=
# 重複チェック用ハッシュの鍵（暗号化鍵とは別の値にする）
PII_HASH_KEY=

# フォームの「個人情報の取り扱い」に出す運営者名と問い合わせ先
ORGANIZER_NAME="SCRAMBLE SMILE 運営事務局"
PRIVACY_CONTACT=

# 受付URL・QRコードのドメイン（未設定なら Vercel の本番URL）
APP_URL=http://localhost:3000

# メール（Resend）。未設定ならメールは送らずにログだけ出す
RESEND_API_KEY=
MAIL_FROM="SCRAMBLE SMILE 運営事務局 <info@cobo.jp>"
MAIL_REPLY_TO=

# ボット対策（Cloudflare Turnstile）。未設定なら検証しない
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 送信回数制限で使う IP のハッシュ用ソルト（任意の長い文字列）
IP_HASH_SALT=
